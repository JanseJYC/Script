            BindCorner.Parent = Bind

            BindIcon.Name = "Icon"
            BindIcon.Parent = Bind
            BindIcon.BackgroundTransparency = 1
            BindIcon.Position = UDim2.new(0.02, 0, 0.2, 0)
            BindIcon.Size = UDim2.new(0, 24, 0, 24)
            BindIcon.Image = ImageAssets.Keybind
            BindIcon.ImageColor3 = ThemeColors.Accent

            BindTitle.Name = "Title"
            BindTitle.Parent = Bind
            BindTitle.BackgroundTransparency = 1
            BindTitle.Position = UDim2.new(0.1, 0, 0, 0)
            BindTitle.Size = UDim2.new(0, 200, 1, 0)
            BindTitle.Font = Enum.Font.Gotham
            BindTitle.Text = text
            BindTitle.TextColor3 = ThemeColors.Text
            BindTitle.TextSize = 14
            BindTitle.TextXAlignment = Enum.TextXAlignment.Left

            BindText.Name = "BindText"
            BindText.Parent = Bind
            BindText.BackgroundTransparency = 1
            BindText.Position = UDim2.new(1, -60, 0, 0)
            BindText.Size = UDim2.new(0, 50, 1, 0)
            BindText.Font = Enum.Font.Gotham
            BindText.Text = Key
            BindText.TextColor3 = ThemeColors.Accent
            BindText.TextSize = 13
            BindText.TextXAlignment = Enum.TextXAlignment.Right

            Bind.MouseButton1Click:Connect(function()
                BindText.Text = "..."
                binding = true
                local inputwait = UserInputService.InputBegan:wait()
                if inputwait.KeyCode.Name ~= "Unknown" then
                    BindText.Text = inputwait.KeyCode.Name
                    Key = inputwait.KeyCode.Name
                    binding = false
                end
            end)

            UserInputService.InputBegan:Connect(function(current, pressed)
                if not pressed and current.KeyCode.Name == Key and not binding then
                    pcall(callback)
                end
            end)

            Tab.CanvasSize = UDim2.new(0, 0, 0, TabLayout.AbsoluteContentSize.Y)
        end

        function tabcontent:ThemeSelector()
            local ThemeFrame = Instance.new("Frame")
            local ThemeCorner = Instance.new("UICorner")
            local ThemeTitle = Instance.new("TextLabel")
            local ThemeIcon = Instance.new("ImageLabel")
            local ThemeButtons = Instance.new("Frame")
            local KeepColor = Instance.new("BoolValue", ThemeFrame)
            KeepColor.Name = "KeepColor"

            ThemeFrame.Name = "ThemeFrame"
            ThemeFrame.Parent = Tab
            ThemeFrame.BackgroundColor3 = ThemeColors.Second
            ThemeFrame.Size = UDim2.new(0, 363, 0, 60)

            ThemeCorner.CornerRadius = UDim.new(0, 6)
            ThemeCorner.Parent = ThemeFrame

            ThemeIcon.Name = "Icon"
            ThemeIcon.Parent = ThemeFrame
            ThemeIcon.BackgroundTransparency = 1
            ThemeIcon.Position = UDim2.new(0.02, 0, 0.2, 0)
            ThemeIcon.Size = UDim2.new(0, 24, 0, 24)
            ThemeIcon.Image = ImageAssets.Theme
            ThemeIcon.ImageColor3 = ThemeColors.Accent

            ThemeTitle.Name = "Title"
            ThemeTitle.Parent = ThemeFrame
            ThemeTitle.BackgroundTransparency = 1
            ThemeTitle.Position = UDim2.new(0.1, 0, 0, 0)
            ThemeTitle.Size = UDim2.new(0, 150, 1, 0)
            ThemeTitle.Font = Enum.Font.Gotham
            ThemeTitle.Text = "主题切换"
            ThemeTitle.TextColor3 = ThemeColors.Text
            ThemeTitle.TextSize = 14
            ThemeTitle.TextXAlignment = Enum.TextXAlignment.Left

            ThemeButtons.Name = "ThemeButtons"
            ThemeButtons.Parent = ThemeFrame
            ThemeButtons.BackgroundTransparency = 1
            ThemeButtons.Position = UDim2.new(0.4, 0, 0.15, 0)
            ThemeButtons.Size = UDim2.new(0, 200, 0, 40)

            local themeList = {"Default", "Dark", "Light", "Midnight"}
            local colors = {
                Default = Color3.fromRGB(0, 255, 255),
                Dark = Color3.fromRGB(100, 150, 255),
                Light = Color3.fromRGB(80, 120, 255),
                Midnight = Color3.fromRGB(150, 100, 255)
            }

            for i, themeName in ipairs(themeList) do
                local ThemeBtn = Instance.new("TextButton")
                local BtnCorner = Instance.new("UICorner")

                ThemeBtn.Name = themeName .. "Btn"
                ThemeBtn.Parent = ThemeButtons
                ThemeBtn.BackgroundColor3 = colors[themeName]
                ThemeBtn.Position = UDim2.new((i-1) * 0.25, 5, 0, 0)
                ThemeBtn.Size = UDim2.new(0.23, 0, 1, 0)
                ThemeBtn.Font = Enum.Font.Gotham
                ThemeBtn.Text = ""
                ThemeBtn.AutoButtonColor = false

                BtnCorner.CornerRadius = UDim.new(0, 4)
                BtnCorner.Parent = ThemeBtn

                ThemeBtn.MouseButton1Click:Connect(function()
                    lib:SetTheme(themeName)
                    for _, btn in ipairs(ThemeButtons:GetChildren()) do
                        if btn:IsA("TextButton") then
                            TweenService:Create(btn, TweenInfo.new(0.3), {Size = UDim2.new(0.23, 0, 1, 0)}):Play()
                        end
                    end
                    TweenService:Create(ThemeBtn, TweenInfo.new(0.3), {Size = UDim2.new(0.25, 0, 1.1, 0)}):Play()
                end)

                ThemeBtn.MouseEnter:Connect(function()
                    TweenService:Create(ThemeBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.3}):Play()
                end)

                ThemeBtn.MouseLeave:Connect(function()
                    TweenService:Create(ThemeBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
                end)
            end

            Tab.CanvasSize = UDim2.new(0, 0, 0, TabLayout.AbsoluteContentSize.Y)
        end

        return tabcontent
    end
    return tabhold
end

